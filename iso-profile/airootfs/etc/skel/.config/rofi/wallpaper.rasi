/* Rofi Wallpaper Grid Theme - NooreldeanOS */
@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    show-icons: true;
    font: "Outfit, JetBrainsMono Nerd Font 12";
}

* {
    background-color: transparent;
    text-color: @foreground;
}

window {
    transparency: "real";
    width: 960px;
    height: 640px;
    background-color: #0D0C0EF0;
    border: 2px;
    border-color: @selected-normal-background;
    border-radius: 20px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 10px 16px;
    spacing: 12px;
}

prompt {
    text-color: @selected-normal-background;
    font: "Outfit Bold 13";
}

entry {
    placeholder: "ابحث عن خلفية بالاسم...";
    placeholder-color: #6c7086;
    text-color: @foreground;
}

listview {
    columns: 4;
    lines: 3;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 16px;
    background-color: transparent;
}

element {
    orientation: vertical;
    border-radius: 14px;
    padding: 12px 8px;
    spacing: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    border: 1px;
    border-color: transparent;
}

element selected {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: @selected-normal-background;
    text-color: #ffffff;
}

element-icon {
    size: 110px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "Outfit, JetBrainsMono Nerd Font 11";
    cursor: inherit;
    text-color: inherit;
}
