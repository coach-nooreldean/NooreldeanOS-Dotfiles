#!/usr/bin/env bash
# ==============================================================================
# NooreldeanOS Live Installer Launcher
# ==============================================================================

set -euo pipefail

notify-send -a "NooreldeanOS" -u normal -i "system-software-install" "مثبت NooreldeanOS" "جاري تشغيل مثبت النظام الرسومي Calamares..." || true

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec calamares -d "$@"
  else
    exec sudo calamares -d "$@"
  fi
else
  exec calamares -d "$@"
fi
