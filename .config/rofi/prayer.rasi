@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    font: "Cairo, JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 560px;
    background-color: #0D0C0EF5; /* 96% opacity */
    border: 2px;
    border-color: @selected-normal-background;
    border-radius: 20px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ prompt, listview ];
    spacing: 16px;
}

prompt {
    font: "Cairo Bold 17";
    text-color: @selected-normal-background;
    padding: 6px;
    horizontal-align: 0.5;
}

listview {
    lines: 6;
    columns: 1;
    scrollbar: false;
    spacing: 8px;
    dynamic: false;
    fixed-height: true;
    background-color: transparent;
}

element {
    padding: 10px 16px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.03);
}

element selected {
    background-color: @selected-normal-background;
    text-color: #0D0C0E;
}

element-text {
    horizontal-align: 0;
    vertical-align: 0.5;
    expand: true;
    text-color: inherit;
    font: inherit;
}
