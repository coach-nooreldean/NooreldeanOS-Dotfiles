/* Rofi Audio Output Switcher Theme - NooreldeanOS */
@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    show-icons: false;
    font: "Outfit, Tajawal, JetBrainsMono Nerd Font 13";
}

* {
    background-color: transparent;
    text-color: @foreground;
}

window {
    transparency: "real";
    width: 580px;
    background-color: #0D0C0EF5;
    border: 2px;
    border-color: @selected-normal-background;
    border-radius: 18px;
    padding: 20px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 10px 16px;
    spacing: 12px;
}

prompt {
    text-color: @selected-normal-background;
    font: "Outfit Bold 14";
}

entry {
    placeholder: "ابحث أو اختر مخرج الصوت...";
    placeholder-color: #6c7086;
    text-color: @foreground;
}

listview {
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 10px;
    background-color: transparent;
}

element {
    orientation: horizontal;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 14px;
    background-color: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    border: 1px;
    border-color: transparent;
}

element selected {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: @selected-normal-background;
    text-color: #ffffff;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    cursor: inherit;
    text-color: inherit;
}
