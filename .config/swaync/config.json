{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-2way-tz": "local",
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 420,
  "control-center-height": 780,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "chime-sound": {
      "exec": "paplay /usr/share/sounds/freedesktop/stereo/message.oga",
      "urgency": "Normal"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "مركز الإشعارات",
      "clear-all-button": true,
      "button-text": "مسح الكل"
    },
    "dnd": {
      "text": "عدم الإزعاج"
    },
    "mpris": {
      "image-size": 84,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "kitty --title \"إدارة البلوتوث\" -e bluetoothctl"
        },
        {
          "label": "󰕾",
          "command": "~/.config/hypr/scripts/audio_switcher.sh"
        },
        {
          "label": "󰍹",
          "command": "~/.config/hypr/scripts/display_switcher.sh"
        },
        {
          "label": "󰏘",
          "command": "~/.config/hypr/scripts/wallpaper_switcher.sh"
        },
        {
          "label": "󰄬",
          "command": "noor-snap rofi"
        },
        {
          "label": "󰃢",
          "command": "kitty --title \"صيانة النظام\" -e sys-clean"
        },
        {
          "label": "󰌢",
          "command": "wlogout"
        }
      ]
    }
  }
}